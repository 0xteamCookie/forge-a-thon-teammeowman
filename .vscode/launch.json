{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Anvil on Flask 3.1.3",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extension", "${workspaceFolder}/../flask-3.1.3"],
      "outFiles": ["${workspaceFolder}/extension/dist/**/*.js"],
      "preLaunchTask": "anvil: build"
    }
  ]
}
